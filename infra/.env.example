# ==== Конфигурация сервиса «Грейд» (локальный dev и docker-compose) ====
# Копируйте в .env: cp .env.example .env

# --- api (Go) ---
ADDR=:8000
DATABASE_URL=sqlite:///./data/grade.db
# prod: DATABASE_URL=postgres://grade:grade@localhost:5432/grade
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=168
MINUTES_FREE_S=3600
LOG_LEVEL=info

# --- voice (AI-узел; WP-4) ---
VOICE_URL=http://localhost:8100
STT_MODEL=small
TTS_SPEAKER=ru_01

# --- sandbox (Go) ---
SANDBOX_URL=http://localhost:8200
SANDBOX_MODE=docker

# --- LLM (AI-узел; OpenAI-совместимый; ADR-005) ---
LLM_BASE_URL=http://localhost:8300/v1
LLM_MODEL=Qwen3-4B
LLM_API_KEY=

# --- Голос (оркестратор api; ADR-002) ---
VAD_END_SILENCE_MS=900
SILENCE_NUDGE_S=8
SESSION_PAUSE_TIMEOUT_S=1800
