# «Грейд» — шаблон переменных окружения.
# Копировать в .env и заполнять. .env в git не коммитится.
# Справочник по разработке — docs/DEV.md, по эксплуатации — docs/OPERATIONS.md,
# назначение переменных в системе — docs/ARCHITECTURE.md §6.

# === api (services/api, :8000) ===
# Адрес прослушивания
ADDR=:8000
# БД: sqlite:///./data/grade.db (dev) | postgres://user:pass@host:5432/grade (prod)
DATABASE_URL=sqlite:///./data/grade.db
# JWT: секрет подписи токенов, время жизни токенов (ч). В dev допустим дефолт;
# в prod (APP_ENV=prod) шаблонные значения — dev-insecure-secret, change-me*,
# secret — api отвергает на старте. Сгенерировать: openssl rand -base64 32
JWT_SECRET=dev-insecure-secret
JWT_EXPIRY_HOURS=168
# Каталог файлов резюме (текст из них уходит интервьюеру)
RESUME_DIR=./data/resumes
# Пауза дольше порога -> aborted, с (SRS §7)
SESSION_PAUSE_TIMEOUT_S=1800
# Уровень логов (info|debug)
LOG_LEVEL=info
# /metrics — basic-auth (его скрейпит prometheus из docker-сети).
# METRICS_PASSWORD пусто → маршрута /metrics нет вовсе.
# Сгенерировать: openssl rand -base64 18
METRICS_USER=prometheus
METRICS_PASSWORD=

# === LLM (WP-5; prod — vLLM + Qwen3.8-27B на AI-узле, dev — llama.cpp + Qwen3-4B) ===
# OpenAI-совместимый эндпоинт (ADR-005)
LLM_BASE_URL=http://localhost:8300/v1
LLM_MODEL=Qwen3-4B
LLM_API_KEY=
# LLM_MOCK=1 — детерминированный мок вместо реального LLM (dev без LLM-узла, CI)
LLM_MOCK=1
# LLM_ENABLE_THINKING — vLLM chat_template_kwargs.enable_thinking (реализация только vLLM).
# Дефолт false: отключает reasoning-фазу thinking-моделей (первый content-токен без
# паузы 2.7-7.9 с) — SLO голосового контура p95 хода < 4 с.
LLM_ENABLE_THINKING=false
# (опц.) APP_CONFIG_FILE — единый файл настроек, которые пишет экран «Настройки»:
# LLM (эндпоинт/модель/thinking), адреса voice и sandbox, пороги тишины/VAD,
# рамки сессии. Старшинство: переменная окружения > файл > дефолт кода;
# применяется при старте api. Секреты в файл не пишутся — живут только в
# окружении. LLM_CONFIG_FILE — историческое имя той же переменной.
# APP_CONFIG_FILE=config/app.json
# ENABLE_DEBUG=1 — dev-эндпоинты диагностики (POST /debug/mic-report; приём
# отчётов микрофона из audio-debug.html / mic.ts). В prod держать пустым (404).
ENABLE_DEBUG=
# nudge: тишина кандидата дольше N секунд -> ход ИИ («всё понятно?»)
SILENCE_NUDGE_S=45
# VAD (оркестратор голосового хода, ADR-002): конец реплики по тишине, мс (700-1200)
VAD_END_SILENCE_MS=900
# VAD: порог RMS int16 «речь есть» (голос ~1000-10000, тишина < 200)
VAD_RMS_THRESHOLD=500

# === voice (services/voice, :8100; prod — AI-узел в ЛВС) ===
VOICE_URL=http://localhost:8100
# STT-провайдер: gigaam (default проекта — см. AGENTS.md) | faster-whisper | fake (CI)
#   gigaam — GigaAM v3 (Sber, MIT): RU WER в ~2 раза ниже Whisper large-v3,
#            ~5-6x быстрее; v3_e2e_rnnt — пунктуация+капитализация.
#            env: GIGAAM_MODEL (default v3_e2e_rnnt; ещё v3_rnnt/v3_ctc/v3_e2e_ctc/...),
#                 GIGAAM_DEVICE (cpu|cuda, default auto), GIGAAM_DOWNLOAD_ROOT (default models/stt-gigaam).
#   faster-whisper — размер: tiny | base | small | mid | large-v3 (dev без GPU — small/tiny;
#            ленивое скачивание, кэш ~/.cache/huggingface или STT_DOWNLOAD_ROOT).
VOICE_STT_PROVIDER=gigaam
VOICE_TTS_PROVIDER=silero
# (faster-whisper) STT_MODEL=small | large-v3; STT_LANGUAGE=ru
# (faster-whisper, опц.) STT_DEVICE=cpu|cuda; STT_DOWNLOAD_ROOT — кэш модели
# (опц.) GIGAAM_MODEL=v3_e2e_rnnt | v3_rnnt | v3_ctc | v3_e2e_ctc | ...
# (опц.) GIGAAM_DOWNLOAD_ROOT=models/stt-gigaam  (скачивание: scripts/download-models.sh)
# TTS: Silero v5 — спикер (v5_ru: aidar, baya, kseniya, eugene, xenia;
#  нет в модели -> дефолтный + warning)
TTS_SPEAKER=xenia
# (опц.) VOICE_MODELS_FILE — файл выбора провайдеров/моделей голоса
# (админка «Система» пишет его через api). env > файл > дефолт, применяется
# при старте voice.
# VOICE_MODELS_FILE=config/voice-models.json
# (опц.) VOICE_ADMIN_TOKEN — токен записи PUT /api/v1/config/models. Нужен в ДВУХ
# сервисах: voice (принимает запись) и api (пробрасывает свой). Не задан в voice
# запись 503, панель только читает; не задан в api панель пишет «права не выданы».
# VOICE_ADMIN_TOKEN=
# (опц.) каталог/файл TTS-модели: TTS_MODEL_DIR / TTS_MODEL_PATH

# === sandbox (services/sandbox, :8200; ADR-003) ===
SANDBOX_URL=http://localhost:8200
# docker (prod, fail-closed без демона) | subprocess (dev; дефолт без docker)
SANDBOX_MODE=subprocess
# (опц.) корень рабочих каталогов runner: SANDBOX_WORKDIR_BASE (не /tmp!)
# (spec-24) пул сгенерированных задач: файл-overlay поверх встроенного банка и
# токен управления. Без токена /admin/tasks* отдают 503 (генерация выключена).
# SANDBOX_TASKS_FILE=./data/generated-tasks.json
# SANDBOX_ADMIN_TOKEN=
# (dev, subprocess) python-задачи проверяет pytest; у системного python3 его
# может не быть — тогда тесты банка не выполняются ни у одной python-задачи
# (на старте sandbox пишет ERROR). Указать интерпретатор с pytest:
# SANDBOX_CMD_PYTHON=/path/.venv/bin/python -m pytest -q -p no:cacheprovider %GRADER%
# В prod pytest запечён в образ (infra/docker-compose.yml: SANDBOX_IMAGE_PYTHON).
# api читает тот же токен и фоном держит в пуле не меньше SANDBOX_TASKS_MIN
# задач на (стек, грейд): SANDBOX_TASKS_MIN=4, SANDBOX_TASKS_PER_TICK=4,
# SANDBOX_TASKS_INTERVAL_S=600. Без токена пополнение выключено.
# Разнообразие от модели (по одной попытке за тик, приём только по gate):
# SANDBOX_TASKS_SKIN=1 — переписать условие семьи под домен (файлы и проверки
# остаются из семьи); SANDBOX_TASKS_LLM_GEN=1 — модель пишет задачу целиком;
# SANDBOX_TASKS_DOMAIN — предметная область для переписывания.

# === frontend (dev) ===
# Dev-прокси /api, /healthz, /ws → http://localhost:8000 встроен в vite.config.ts;
# переменные VITE_API_URL / VITE_WS_URL в текущем коде фронтенда не используются.
# VITE_MIC_DEBUG=1 — расширенная диагностика микрофона в консоли (audio-debug,
# T-20261008175905). BUILD-время (vite env инлайнятся в сборку): в prod-сборке
# (nginx/Dockerfile) переменная не передаётся — выключено.

# === prod: reverse-proxy / TLS (caddy, profile prod; docs/OPERATIONS.md) ===
# Публичный домен (Let's Encrypt). Без публичного IP — localhost + CADDY_TLS=internal
GRADE_DOMAIN=interview.example.com
# TLS-режим: пустое = автоматический Let's Encrypt; internal = встроенный CA Caddy
# (локальная VPS-проверка без публичного IP; корневой CA — volume caddy_data)
CADDY_TLS=
# Ограничения voice (prod): CPU / память
VOICE_CPU_LIMIT=4
VOICE_MEM_LIMIT=8g

# === monitoring (profile monitoring) ===
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# === prod: права и зеркала сборки (docs/OPERATIONS.md) ===
# uid/gid в контейнерах api, voice, sandbox (дефолт 1000). Совпадает с владельцем
# биндов — иначе контейнеры падают на записи.
# GRADE_UID=1000
# GRADE_GID=1000
# Зеркало pypi для сборки voice, если pypi.org недоступен (дефолт — pypi.org)
# PIP_INDEX_URL=
# Длительность сессии: пусто — по грейду (45/50/60/75 мин), число — фиксированный
# лимит в секундах, "off" — без ограничения по времени
# SESSION_LIMIT_S=
