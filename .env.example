# «Грейд» — шаблон переменных окружения (dev).
# Копировать в .env и заполнять. .env в git не коммитится.
# Полный справочник — ARCHITECTURE.md §6.

# === api (services/api, :8000) ===
# Адрес прослушивания
ADDR=:8000
# БД: sqlite:///./data/grade.db (dev) | postgres://user:pass@host:5432/grade (prod)
DATABASE_URL=sqlite:///./data/grade.db
# JWT: секрет (в dev допустим дефолт, в prod — обязательно сменить), время жизни токенов (ч)
JWT_SECRET=dev-insecure-secret
JWT_EXPIRY_HOURS=168
# Стартовый грант минут (SRS §7: 60 мин = 3600 с)
MINUTES_FREE_S=3600000  # MVP: «безлимит» (тарификация — при запуске prod-биллинга)
# Пауза дольше порога -> aborted + списание фактического времени, с (SRS §7)
SESSION_PAUSE_TIMEOUT_S=1800
# Уровень логов (info|debug)
LOG_LEVEL=info

# === LLM (WP-5; prod — vLLM + Qwen3.8-27B на AI-узле, dev — llama.cpp + Qwen3-4B) ===
# OpenAI-совместимый эндпоинт (ADR-005)
LLM_BASE_URL=http://localhost:8300/v1
LLM_MODEL=Qwen3-4B
LLM_API_KEY=
# LLM_MOCK=1 — детерминированный мок вместо реального LLM (dev без LLM-узла, CI)
LLM_MOCK=1
# LLM_ENABLE_THINKING — vLLM chat_template_kwargs.enable_thinking (реализация только vLLM).
# Дефолт false: отключает reasoning-фазу thinking-моделей (первый content-токен без
# паузы 2.7-7.9 с) — SLO голосового контура p95 хода < 4 с.
LLM_ENABLE_THINKING=false
# ENABLE_DEBUG=1 — dev-эндпоинты диагностики (POST /debug/mic-report; приём
# отчётов микрофона из audio-debug.html / mic.ts). В prod держать пустым (404).
ENABLE_DEBUG=
# nudge: тишина кандидата дольше N секунд -> ход ИИ («всё понятно?»)
SILENCE_NUDGE_S=45
# VAD (оркестратор голосового хода, ADR-002): конец реплики по тишине, мс (700-1200)
VAD_END_SILENCE_MS=900
# VAD: порог RMS int16 «речь есть» (голос ~1000-10000, тишина < 200)
VAD_RMS_THRESHOLD=500

# === voice (services/voice, :8100; prod — AI-узел в ЛВС) ===
VOICE_URL=http://localhost:8100
# STT: faster-whisper — размер модели: tiny | base | small | mid | large-v3
# (default small; dev без GPU — small или tiny; скачивается лениво при первом /api/v1/stt,
#  кэш — ~/.cache/huggingface)
STT_MODEL=small
STT_LANGUAGE=ru
# (опц.) STT_DEVICE=cpu|cuda
# (опц.) STT_DOWNLOAD_ROOT — каталог скачивания/кэша STT-модели (compose: /models/stt;
#  dev: дефолт — кэш faster-whisper ~/.cache/huggingface)
# TTS: Silero v5 — спикер (v5_ru: aidar, baya, kseniya, eugene, xenia;
#  нет в модели -> дефолтный + warning)
TTS_SPEAKER=ru_01
# Выбор провайдеров: faster-whisper/silero (default) | fake (CI, без ML-моделей)
VOICE_STT_PROVIDER=faster-whisper
VOICE_TTS_PROVIDER=silero
# (опц.) каталог/файл TTS-модели: TTS_MODEL_DIR / TTS_MODEL_PATH

# === sandbox (services/sandbox, :8200; ADR-003) ===
SANDBOX_URL=http://localhost:8200
# docker (prod, fail-closed без демона) | subprocess (dev; дефолт без docker)
SANDBOX_MODE=subprocess
# (опц.) корень рабочих каталогов runner: SANDBOX_WORKDIR_BASE (не /tmp!)

# === frontend (dev) ===
# Dev-прокси /api, /healthz, /ws → http://localhost:8000 встроен в vite.config.ts;
# переменные VITE_API_URL / VITE_WS_URL в текущем коде фронтенда не используются.
# VITE_MIC_DEBUG=1 — расширенная диагностика микрофона в консоли (audio-debug,
# T-20261008175905). BUILD-время (vite env инлайнятся в сборку): в prod-сборке
# (nginx/Dockerfile) переменная не передаётся — выключено.

# === prod: reverse-proxy / TLS (caddy, profile prod; docs/OPERATIONS.md) ===
# Публичный домен (Let's Encrypt). Без публичного IP — localhost + CADDY_TLS=internal
GRADE_DOMAIN=interview.example.com
# TLS-режим: пустое = автоматический Let's Encrypt; internal = встроенный CA Caddy
# (локальная VPS-проверка без публичного IP; корневой CA — volume caddy_data)
CADDY_TLS=
# Ограничения voice (prod): CPU / память
VOICE_CPU_LIMIT=4
VOICE_MEM_LIMIT=8g

# === monitoring (profile monitoring) ===
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
